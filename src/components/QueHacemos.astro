---
import { Code2, BarChart2, Cloud, Layers, Globe, Cog } from 'lucide-react';

const servicesTop = [
  {
    icon: Cloud,
    title: "Soluciones Cloud & DevOps",
    desc: "Diseñamos e implementamos infraestructuras cloud escalables y pipelines CI/CD que aceleran el ciclo de entrega y maximizan la disponibilidad de tus sistemas."
  }
];

const servicesMiddle = [
  {
    icon: Code2,
    title: "Desarrollo a Medida",
    desc: "Construimos aplicaciones web y sistemas B2B de alto rendimiento con arquitecturas escalables, priorizando la calidad del código y la velocidad de entrega."
  },
  {
    icon: BarChart2,
    title: "Estrategia Digital",
    desc: "Definimos y ejecutamos estrategias digitales que conectan tecnología con resultados medibles: SEO técnico, analítica avanzada y optimización de conversión."
  },
  {
    icon: Globe,
    title: "Presencia Web Profesional",
    desc: "Creamos sitios y plataformas que proyectan credibilidad, generan confianza y convierten visitantes en clientes con diseño de alto impacto."
  }
];

const servicesBottom = [
  {
    icon: Layers,
    title: "Automatización B2B",
    desc: "Integramos y automatizamos flujos de trabajo críticos entre sistemas, eliminando procesos manuales y reduciendo errores operativos."
  },
  {
    icon: Cog,
    title: "Mantenimiento & Soporte",
    desc: "Garantizamos la operatividad continua de tus sistemas con monitorización proactiva, actualizaciones de seguridad y soporte técnico especializado."
  }
];
---

<section id="que-hacemos" class="py-24 px-4 max-w-6xl mx-auto">

  <div class="flex flex-col items-center justify-center gap-3 mb-20 text-center">
    <div class="inline-flex items-center gap-2 text-stibios-accent text-xs font-mono mb-2 border border-stibios-accent/20 px-3 py-1 rounded-full bg-stibios-accent/5">
      <div class="w-2 h-2 rounded-full bg-stibios-accent animate-pulse"></div>
      NUESTROS SERVICIOS
    </div>
    <h2 class="text-3xl md:text-5xl font-bold text-white tracking-tighter mx-auto uppercase">
      Qué Hacemos
    </h2>
    <p class="text-stibios-dim mt-2 text-sm md:text-base font-mono max-w-lg text-center">
      &gt; Tecnología aplicada a resultados de negocio concretos.
    </p>
    <div class="w-12 h-1 bg-stibios-accent/30 rounded-full mt-4"></div>
  </div>

  <!-- Bento grid: asymmetric layout with images breaking the card grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 auto-rows-auto">

    <!-- Row 1: Cloud card (1 col) + datacenter image (2 cols wide) -->
    {servicesTop.map((s) => (
      <div class="group bg-stibios-surface border border-stibios-border rounded-2xl p-8 transition-all duration-500 hover:border-stibios-accent/50 hover:shadow-[0_0_40px_rgba(0,209,255,0.08)] flex flex-col justify-between min-h-[220px]">
        <div class="w-14 h-14 bg-stibios-bg border border-stibios-border rounded-xl flex items-center justify-center mb-6 group-hover:border-stibios-accent/40 group-hover:bg-stibios-accent/[0.04] transition-all duration-500 shadow-xl shadow-black/20">
          <s.icon className="text-stibios-dim group-hover:text-stibios-accent transition-colors" size={28} />
        </div>
        <h3 class="text-xl font-bold text-white mb-3 group-hover:text-stibios-accent transition-colors">
          {s.title}
        </h3>
        <p class="text-stibios-dim text-sm leading-relaxed">
          {s.desc}
        </p>
      </div>
    ))}

    <!-- Datacenter image: spans 2 columns -->
    <div class="md:col-span-2 overflow-hidden rounded-2xl shadow-2xl">
      <img
        src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=1200&auto=format&fit=crop&q=80"
        alt="Datacenter de alto rendimiento"
        class="w-full h-full min-h-[220px] object-cover rounded-2xl hover:scale-[1.02] transition-all duration-500"
      />
    </div>

    <!-- Row 2: 3 service cards -->
    {servicesMiddle.map((s) => (
      <div class="group bg-stibios-surface border border-stibios-border rounded-2xl p-8 transition-all duration-500 hover:border-stibios-accent/50 hover:shadow-[0_0_40px_rgba(0,209,255,0.08)]">
        <div class="w-14 h-14 bg-stibios-bg border border-stibios-border rounded-xl flex items-center justify-center mb-6 group-hover:border-stibios-accent/40 group-hover:bg-stibios-accent/[0.04] transition-all duration-500 shadow-xl shadow-black/20">
          <s.icon className="text-stibios-dim group-hover:text-stibios-accent transition-colors" size={28} />
        </div>
        <h3 class="text-xl font-bold text-white mb-3 group-hover:text-stibios-accent transition-colors">
          {s.title}
        </h3>
        <p class="text-stibios-dim text-sm leading-relaxed">
          {s.desc}
        </p>
      </div>
    ))}

    <!-- Row 3: dev workspace image (1 col) + 2 service cards -->
    <div class="overflow-hidden rounded-2xl shadow-2xl">
      <img
        src="https://images.unsplash.com/photo-1629904853893-c2c8981a1dc5?w=800&auto=format&fit=crop&q=80"
        alt="Setup de desarrollo minimalista"
        class="w-full h-full min-h-[200px] object-cover rounded-2xl hover:scale-[1.02] transition-all duration-500"
      />
    </div>

    {servicesBottom.map((s) => (
      <div class="group bg-stibios-surface border border-stibios-border rounded-2xl p-8 transition-all duration-500 hover:border-stibios-accent/50 hover:shadow-[0_0_40px_rgba(0,209,255,0.08)]">
        <div class="w-14 h-14 bg-stibios-bg border border-stibios-border rounded-xl flex items-center justify-center mb-6 group-hover:border-stibios-accent/40 group-hover:bg-stibios-accent/[0.04] transition-all duration-500 shadow-xl shadow-black/20">
          <s.icon className="text-stibios-dim group-hover:text-stibios-accent transition-colors" size={28} />
        </div>
        <h3 class="text-xl font-bold text-white mb-3 group-hover:text-stibios-accent transition-colors">
          {s.title}
        </h3>
        <p class="text-stibios-dim text-sm leading-relaxed">
          {s.desc}
        </p>
      </div>
    ))}

  </div>

</section>
