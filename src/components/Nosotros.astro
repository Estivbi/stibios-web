---
import { Users, Code2, Heart } from "lucide-react";
---

<section id="nosotros" class="py-24 px-4 relative overflow-hidden">
  <div
    class="absolute inset-0 bg-gradient-to-b from-transparent via-stibios-accent/[0.02] to-transparent pointer-events-none"
  >
  </div>
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-px bg-gradient-to-r from-transparent via-stibios-border to-transparent"
  >
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div
      class="flex flex-col items-center justify-center gap-3 mb-20 text-center"
    >
      <div
        class="inline-flex items-center gap-2 text-stibios-purple text-xs font-mono mb-2 border border-stibios-purple/20 px-3 py-1 rounded-full bg-stibios-purple/5"
      >
        <Users size={12} className="text-stibios-purple" />
        QUIÉN SOY
      </div>
      <h2
        class="text-3xl md:text-5xl font-bold text-white tracking-tighter mx-auto uppercase"
      >
        Sobre mí
      </h2>
      <div class="w-12 h-1 bg-stibios-purple/30 rounded-full mt-4"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-20">
      <div class="flex flex-col gap-6">
        <p class="text-stibios-dim text-lg leading-relaxed">
          Soy <span class="text-white font-bold">Carolina Rodríguez Bárcena</span>, fundadora de Stibios Labs —
          un estudio de software unipersonal especializado en productos digitales
          para negocios pequeños y creadores.
        </p>
        <p class="text-stibios-dim text-base leading-relaxed">
          Construyo software para mis clientes (la peluquería, el abogado, la
          revista) y para mí misma (productos propios). Sin intermediarios,
          sin plantillas — código y estrategia a medida.
        </p>
        <p class="text-stibios-dim text-base leading-relaxed">
          Trabajo de forma <span class="text-stibios-accent font-mono"
            >100% remota</span
          >, lo que me permite colaborar con negocios de cualquier parte del mundo sin
          perder la cercanía y la agilidad que me caracteriza.
        </p>
        <div
          class="flex flex-wrap gap-6 mt-4 font-mono text-xs text-stibios-dim/60 border-t border-stibios-border pt-6"
        >
          <div class="flex flex-col gap-1">
            <span class="text-white text-2xl font-bold">+20</span>
            <span>proyectos entregados</span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-white text-2xl font-bold">100%</span>
            <span>Satisfacción del cliente</span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-stibios-accent text-2xl font-bold">100%</span>
            <span>Soporte Dedicado</span>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <!-- Terminal (core element — unchanged) -->
        <div class="relative">
          <div
            class="bg-stibios-surface border border-stibios-border rounded-2xl p-8 font-mono text-xs leading-relaxed text-stibios-dim"
          >
            <div class="flex items-center gap-2 mb-4">
              <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/70"></div>
              <span class="ml-2 text-stibios-dim/50">stibios.config.ts</span>
            </div>
            <pre
              class="text-left overflow-x-auto"><code><span class="text-stibios-purple">const</span> <span class="text-stibios-accent">stibios</span> = &#123;
  <span class="text-stibios-text">nombre</span>: <span class="text-emerald-400">"Stibios Labs"</span>,
  <span class="text-stibios-text">tipo</span>: <span class="text-emerald-400">"Estudio unipersonal"</span>,
  <span class="text-stibios-text">ubicación</span>: <span class="text-emerald-400">"Remoto / España"</span>,
  <span class="text-stibios-text">especialidades</span>: [
    <span class="text-emerald-400">"Desarrollo Web"</span>,
    <span class="text-emerald-400">"Productos Digitales"</span>,
    <span class="text-emerald-400">"Automatización"</span>,
    <span class="text-emerald-400">"Estrategia Digital"</span>,
  ],
  <span class="text-stibios-text">valores</span>: [<span class="text-emerald-400">"honestidad"</span>, <span class="text-emerald-400">"criterio"</span>, <span class="text-emerald-400">"confianza"</span>],
  <span class="text-stibios-text">disponible</span>: <span class="text-stibios-accent">true</span>,
&#125;;</code></pre>
          </div>
          <div
            class="absolute -top-3 -right-3 w-6 h-6 border-t-2 border-r-2 border-stibios-accent/30 rounded-tr-xl"
          >
          </div>
          <div
            class="absolute -bottom-3 -left-3 w-6 h-6 border-b-2 border-l-2 border-stibios-purple/30 rounded-bl-xl"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
