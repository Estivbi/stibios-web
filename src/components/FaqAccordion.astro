---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="faq-list">
  {items.map((item, i) => (
    <div class="faq-item">
      <h3 class="faq-item__heading">
        <button
          type="button"
          class="faq-item__trigger"
          aria-expanded="false"
          aria-controls={`faq-panel-${i}`}
        >
          <span>{item.q}</span>
          <svg class="faq-item__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </button>
      </h3>
      <div id={`faq-panel-${i}`} class="faq-item__panel">
        <div class="faq-item__panel-inner">
          <p class="faq-item__answer">{item.a}</p>
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: var(--color-stibios-surface);
    border: 1px solid var(--color-stibios-border);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .faq-item__heading {
    margin: 0;
  }

  .faq-item__trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 1.25rem;
    background: none;
    border: none;
    cursor: pointer;
    font-weight: 600;
    color: var(--color-stibios-text);
    font-size: 0.9rem;
    font-family: inherit;
    text-align: left;
  }

  .faq-item__chevron {
    flex-shrink: 0;
    margin-left: 1rem;
    transition: transform 0.25s ease-out;
  }

  .faq-item__trigger[aria-expanded="true"] .faq-item__chevron {
    transform: rotate(180deg);
  }

  .faq-item__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 280ms ease;
  }

  .faq-item__panel.is-open {
    grid-template-rows: 1fr;
  }

  .faq-item__panel-inner {
    overflow: hidden;
  }

  .faq-item__answer {
    padding: 0 1.25rem 1.25rem;
    color: var(--color-stibios-dim);
    font-size: 0.875rem;
    line-height: 1.65;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item__panel,
    .faq-item__chevron {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.faq-item__trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const panelId = btn.getAttribute('aria-controls');
      const panel = panelId ? document.getElementById(panelId) : null;
      btn.setAttribute('aria-expanded', String(!expanded));
      panel?.classList.toggle('is-open', !expanded);
    });
  });
</script>
