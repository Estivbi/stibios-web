---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<a href="/" class={`group flex items-center gap-3 font-sans font-black tracking-tighter ${className}`} aria-label="STIBIOS Home">
  <div class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-stibios-surface border border-stibios-border group-hover:border-stibios-accent transition-all duration-500 overflow-hidden shadow-lg shadow-stibios-accent/5">
    <div class="absolute inset-0 bg-gradient-to-br from-stibios-accent via-stibios-purple to-transparent opacity-0 group-hover:opacity-20 transition-opacity"></div>
    <span class="text-transparent bg-clip-text bg-gradient-to-br from-stibios-accent to-stibios-purple text-2xl leading-none font-black">S</span>
  </div>
  
  <div class="flex flex-col leading-[0.8]">
    <span class="text-xl text-stibios-text group-hover:text-white transition-colors tracking-tight">
      STIBIOS<span class="text-stibios-accent">LABS</span>
    </span>
    <span class="text-[8px] font-mono text-stibios-purple tracking-[0.2em] uppercase mt-1 opacity-80">CODE THE FUTURE</span>
  </div>
</a>