---
import { Server, ExternalLink } from "lucide-react";
import custodioPreview from "../assets/capt-custodio.png";
import patriciaPreview from "../assets/capt.porfolio.png";
import rentasPreview from "../assets/capt-rentas.png";
import revistaPreview from "../assets/capt-revista.png";

const projects = [
  {
    name: "CUSTODIO JOSÉ PÉREZ",
    url: "https://www.custodiojoseperez.com/",
    desc: "Plataforma profesional con enfoque en marca personal y servicios legales.",
    preview: custodioPreview,
  },
  {
    name: "PATRICIA MORENO",
    url: "https://patriciamoreno.vercel.app/",
    desc: "Portfolio de alto rendimiento con diseño minimalista y optimización SEO.",
    preview: patriciaPreview,
  },
  {
    name: "RENTAS MEASESORAN",
    url: "https://rentas.measesoran.eu/login",
    desc: "Sistema B2B de gestión tributaria y área de cliente privada.",
    preview: rentasPreview,
  },
  {
    name: "VICTORIA REVISTA",
    url: "https://www.victoriarevista.com/",
    desc: "Magacín digital de alta calidad visual con gestión de contenidos dinámica.",
    preview: revistaPreview,
  }
];
---

<section id="casos-exito" class="py-32 px-4 relative overflow-hidden bg-stibios-bg">
  {/* Fondo con gradiente sutil heredado de la card anterior */}
  <div class="absolute inset-0 bg-gradient-to-b from-gray-500/[0.03] to-transparent pointer-events-none"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-px bg-gradient-to-r from-transparent via-gray-500/20 to-transparent"></div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="flex flex-col items-center text-center mb-16">
      <div class="flex items-center gap-3 mb-4">
        <Server size={32} className="text-purple-500" />
        <h2 class="text-3xl md:text-5xl font-bold text-white tracking-tighter mx-auto">
            Casos de Éxito
          </h2>
      </div>
      <p class="text-stibios-dim text-lg max-w-2xl leading-relaxed text-left">
        Estrategias digitales personalizadas con enfoque en 
        <span class="text-white font-bold italic"> escalabilidad y rendimiento excepcional.</span> 
        Transformamos necesidades de negocio en infraestructura robusta.
      </p>
    </div>

    <!-- Carrusel de Proyectos -->
    <div class="relative group/carousel">
      <div id="carousel-container" class="flex overflow-x-auto snap-x snap-mandatory gap-6 no-scrollbar pb-8 scroll-smooth">
        {projects.map((p) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="min-w-[85vw] md:min-w-[450px] snap-center group relative bg-stibios-surface border border-stibios-border p-6 rounded-2xl transition-all duration-500 hover:border-gray-500/50 hover:shadow-[0_0_40px_rgba(168,85,247,0.1)] flex flex-col"
          >
            <div class="absolute inset-0 bg-gradient-to-br from-gray-500/[0.02] to-transparent opacity-0 group-hover:opacity-100 transition-opacity rounded-2xl"></div>
            
            <div class="w-full h-48 rounded-xl mb-6 overflow-hidden relative border border-white/5 bg-black/30">
              <img
                src={p.preview.src}
                alt={`Captura de ${p.name}`}
                class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-stibios-surface/80 via-transparent to-transparent"></div>
              <div class="absolute top-3 left-3 px-2 py-1 rounded-full bg-black/50 border border-white/10 text-[10px] font-mono tracking-[0.25em] text-white/80 uppercase backdrop-blur-sm">
                Preview
              </div>
            </div>

            <div class="flex-grow">
              <div class="flex justify-between items-start mb-4">
                <div class="w-1.5 h-1.5 bg-purple-500 rounded-full animate-pulse shadow-[0_0_8px_rgba(168,85,247,0.8)]"></div>
                <ExternalLink size={18} className="text-stibios-dim group-hover:text-purple-400 transition-colors" />
              </div>
              <h3 class="text-xl font-bold text-white mb-3 group-hover:text-gray-300 transition-colors uppercase tracking-tight">
                {p.name}
              </h3>
              <p class="text-stibios-dim text-sm leading-relaxed mb-6 text-left">
                {p.desc}
              </p>
            </div>

            <div class="pt-4 border-t border-stibios-border/50">
              <span class="text-[10px] font-mono text-stibios-dim group-hover:text-gray-300 transition-colors">
                // LIVE_PROJECT_STIBIOS_OS
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Flechas de navegación (PC) -->
      <button id="prev" class="hidden md:flex absolute -left-12 top-1/2 -translate-y-1/2 w-12 h-12 items-center justify-center rounded-full border border-stibios-border bg-stibios-surface/50 text-white hover:bg-stibios-accent hover:border-stibios-accent transition-all opacity-0 group-hover/carousel:opacity-100">
        &larr;
      </button>
      <button id="next" class="hidden md:flex absolute -right-12 top-1/2 -translate-y-1/2 w-12 h-12 items-center justify-center rounded-full border border-stibios-border bg-stibios-surface/50 text-white hover:bg-stibios-accent hover:border-stibios-accent transition-all opacity-0 group-hover/carousel:opacity-100">
        &rarr;
      </button>
    </div>
  </div>
</section>

<script>
  const container = document.getElementById('carousel-container');
  const prev = document.getElementById('prev');
  const next = document.getElementById('next');

  if (container && prev && next) {
    prev.addEventListener('click', () => {
      container.scrollBy({ left: -400, behavior: 'smooth' });
    });
    next.addEventListener('click', () => {
      container.scrollBy({ left: 400, behavior: 'smooth' });
    });
  }
</script>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
