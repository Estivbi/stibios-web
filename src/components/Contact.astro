---
import { Send, Terminal } from 'lucide-react';
---

<section id="contacto" class="py-24 px-4 max-w-4xl mx-auto">
  
  <div class="bg-stibios-surface border border-stibios-border rounded-2xl p-8 md:p-12 shadow-2xl relative overflow-hidden">
    
    <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row gap-12">
      
      <div class="flex-1">
        <div class="inline-flex items-center gap-2 text-stibios-accent text-xs font-mono mb-6 border border-stibios-accent/20 px-3 py-1 rounded-full bg-stibios-accent/5">
          <div class="w-2 h-2 rounded-full bg-stibios-accent animate-pulse"></div>
          ABIERTO PARA NUEVOS PROYECTOS
        </div>
        
        <h2 class="text-3xl md:text-5xl font-bold text-white mb-6 tracking-tighter">
          Construyamos algo <br />
          <span class="text-stibios-dim italic">excepcional.</span>
        </h2>
        
        <p class="text-stibios-dim text-lg leading-relaxed mb-10">
          Transformamos ideas complejas en infraestructuras digitales de alto rendimiento. 
          Respondemos en menos de 24 horas para analizar la viabilidad técnica de tu proyecto.
        </p>

        <div class="font-mono text-xs text-stibios-dim/50">
            <p>UBICACIÓN: REMOTO / MUNDIAL</p>
            <p>LATENCY: &lt; 24H RESPONSE</p>
        </div>
      </div>

      <div class="flex-1">
        <form id="contact-form" class="space-y-4">
          <!-- Web3Forms Access Key (User needs to replace this) -->
          <input type="hidden" name="access_key" value="b9ef6ad3-442c-4562-b20c-2e61697ee7a7">
          
          <div class="space-y-1">
            <label for="name" class="text-xs font-mono text-stibios-dim ml-1">NOMBRE O MPRESA</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              placeholder="Tu nombre o Empresa"
              class="w-full bg-stibios-bg border border-stibios-border rounded p-3 text-stibios-text focus:border-stibios-accent focus:ring-1 focus:ring-stibios-accent outline-none transition-all placeholder:text-stibios-border"
              required
            />
          </div>

          <div class="space-y-1">
            <label for="email" class="text-xs font-mono text-stibios-dim ml-1">CORREO ELECTRÓNICO</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              placeholder="hola@empresa.com"
              class="w-full bg-stibios-bg border border-stibios-border rounded p-3 text-stibios-text focus:border-stibios-accent focus:ring-1 focus:ring-stibios-accent outline-none transition-all placeholder:text-stibios-border"
              required
            />
          </div>

          <div class="space-y-1">
            <label for="message" class="text-xs font-mono text-stibios-dim ml-1">DETALLES DEL PROYECTO()</label>
            <textarea 
              id="message" 
              name="message" 
              rows="4" 
              placeholder="Describe tu proyecto..."
              class="w-full bg-stibios-bg border border-stibios-border rounded p-3 text-stibios-text focus:border-stibios-accent focus:ring-1 focus:ring-stibios-accent outline-none transition-all placeholder:text-stibios-border resize-none"
              required
            ></textarea>
          </div>

          <div id="result" class="hidden font-mono text-xs p-3 border rounded mb-2"></div>

          <button id="submit-btn" type="submit" class="w-full bg-stibios-text text-stibios-bg font-bold py-3 rounded hover:bg-white transition-all flex items-center justify-center gap-2 group">
            <span id="btn-text">ENVIAR</span>
            <Send size={16} className="group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform opacity-60" />
          </button>

        </form>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('contact-form');
  const result = document.getElementById('result');
  const btn = document.getElementById('submit-btn');
  const btnText = document.getElementById('btn-text');

  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(form);

    result.classList.remove('hidden');
    result.classList.remove('border-emerald-500', 'text-emerald-400', 'border-red-500', 'text-red-400');
    result.classList.add('border-stibios-border', 'text-stibios-dim');
    result.innerHTML = "> INICIALIZANDO SECUENCIA_DE_ENVÍO...";
    
    btn.disabled = true;
    btnText.innerText = "PROCESANDO...";

    try {
        const response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: formData
        });

        const json = await response.json();

        if (response.status === 200) {
            result.classList.replace('border-stibios-border', 'border-emerald-500');
            result.classList.replace('text-stibios-dim', 'text-emerald-400');
            result.innerHTML = "> ÉXITO: MENSAJE_TRANSMITIDO_CORRECTAMENTE. PROCEDIENDO_A_RESPUESTA_EN_<24H.";
            form.reset();
        } else {
            result.classList.replace('border-stibios-border', 'border-red-500');
            result.classList.replace('text-stibios-dim', 'text-red-400');
            result.innerHTML = "> ERROR: " + (json.message || "FALLO_EN_SERVIDOR");
        }
    } catch (error) {
        result.classList.replace('border-stibios-border', 'border-red-500');
        result.classList.replace('text-stibios-dim', 'text-red-400');
        result.innerHTML = "> ERROR_CRÍTICO: FALLO_EN_LA_CONEXIÓN_DE_RED.";
    } finally {
        btn.disabled = false;
        btnText.innerText = "EJECUTAR ENVÍO";
    }
  });
</script>