---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<nav class="mb-8" aria-label="Breadcrumb">
  <ol class="flex items-center gap-2 text-sm font-mono">
    <li>
      <a href="/" class="text-stibios-dim hover:text-stibios-accent transition-colors">
        Inicio
      </a>
    </li>
    <li class="text-stibios-dim">/</li>
    <li>
      <a href="/blog" class="text-stibios-dim hover:text-stibios-accent transition-colors">
        Blog
      </a>
    </li>
    <li class="text-stibios-dim">/</li>
    <li class="text-stibios-text truncate" aria-current="page">{title}</li>
  </ol>
</nav>
