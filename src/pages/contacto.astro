---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contacto — Stibios Labs",
  "url": "https://www.stibios.com/contacto",
  "about": {
    "@type": "ProfessionalService",
    "name": "Stibios Labs",
    "url": "https://www.stibios.com",
    "areaServed": "ES"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.stibios.com" },
    { "@type": "ListItem", "position": 2, "name": "Contacto", "item": "https://www.stibios.com/contacto" }
  ]
};
---

<Layout
  title="Contacto — Stibios Labs"
  description="Hablemos de tu proyecto. Contacta con Carolina, fundadora de Stibios Labs, para desarrollo web, producto a medida o mantenimiento. Respuesta directa, sin intermediarios."
>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="pt-32 pb-4 px-6 max-w-4xl mx-auto text-center">
    <nav class="text-xs font-mono text-stibios-dim flex items-center justify-center gap-2 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-stibios-accent transition-colors">Inicio</a>
      <span>/</span>
      <span class="text-stibios-text">Contacto</span>
    </nav>
    <div class="inline-flex items-center gap-2 text-stibios-accent text-xs font-mono border border-stibios-accent/20 px-3 py-1 rounded-full bg-stibios-accent/5 mb-6">
      <div class="w-2 h-2 rounded-full bg-stibios-accent animate-pulse"></div>
      HABLEMOS DE TU PROYECTO
    </div>
    <h1 class="text-4xl md:text-6xl font-bold tracking-tighter text-white mb-4">
      Contacta con Stibios Labs
    </h1>
    <p class="text-stibios-dim text-lg leading-relaxed max-w-2xl mx-auto">
      Cuéntame en qué estás pensando y te respondo directamente yo, sin intermediarios. Analizamos juntos la viabilidad de tu proyecto y te doy un presupuesto claro, sin sorpresas.
    </p>
  </section>

  <Contact />
  <Footer />
</Layout>
