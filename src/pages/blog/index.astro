---
import Layout from '../../layouts/Layout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';

interface PostFrontmatter {
  title: string;
  description?: string;
  date: string;
  tag?: string;
  image?: string;
  draft: boolean;
}

interface Post {
  frontmatter: PostFrontmatter;
  url?: string;
}

const postModules = import.meta.glob('./*.md', { eager: true });
const posts = Object.values(postModules) as Post[];
const sortedPosts = posts
  .filter(p => !p.frontmatter.draft)
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());

const tags = [...new Set(sortedPosts.map(p => p.frontmatter.tag).filter(Boolean))] as string[];
---

<Layout title="Blog" description="Artículos sobre software, negocios digitales y desarrollo a medida por Stibios Labs.">
  <section class="blog-index">
    <div class="blog-index__container">

      <header class="blog-index__header">
        <div class="blog-index__header-label">
          <span class="blog-index__header-dot"></span>
          <span>Blog</span>
        </div>
        <h1 class="blog-index__title">
          Notas & Reflexiones
        </h1>
        <p class="blog-index__subtitle">
          Ideas sobre software, negocios digitales y desarrollo a medida.
        </p>
        <div class="blog-index__header-line"></div>
      </header>

      <div class="blog-filter" role="group" aria-label="Filtrar por categoría">
        <button type="button" class="blog-filter__btn is-active" data-tag="all">Todos</button>
        {tags.map(tag => (
          <button type="button" class="blog-filter__btn" data-tag={tag}>{tag}</button>
        ))}
      </div>

      <div class="blog-index__grid" id="blog-grid">
        {sortedPosts.map((post, index) => (
          <BlogPostCard post={post} index={index} />
        ))}

        {sortedPosts.length === 0 && (
          <p class="blog-index__empty">Próximamente...</p>
        )}
      </div>

      <p class="blog-index__empty blog-index__empty--filtered" id="blog-empty-filtered" hidden>
        No hay artículos con esta etiqueta todavía.
      </p>

      <nav class="blog-pagination" id="blog-pagination" aria-label="Paginación del blog"></nav>

    </div>
  </section>
</Layout>

<style>
  /* ── Blog Index Section ── */
  .blog-index {
    position: relative;
    padding: 7rem 1.5rem 4rem;
  }

  @media (min-width: 768px) {
    .blog-index {
      padding: 9rem 2rem 5rem;
    }
  }

  .blog-index__container {
    max-width: 56rem;
    margin: 0 auto;
  }

  /* ── Header ── */
  .blog-index__header {
    margin-bottom: 3rem;
  }

  .blog-index__header-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-stibios-accent);
    margin-bottom: 0.75rem;
  }

  .blog-index__header-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-stibios-accent);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(0, 209, 255, 0.4); }
    50% { opacity: 0.7; box-shadow: 0 0 0 6px rgba(0, 209, 255, 0); }
  }

  .blog-index__title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-stibios-text);
    line-height: 1.15;
    margin: 0;
  }

  @media (min-width: 768px) {
    .blog-index__title {
      font-size: 2.75rem;
    }
  }

  .blog-index__subtitle {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--color-stibios-dim);
    line-height: 1.5;
  }

  .blog-index__header-line {
    margin-top: 1.5rem;
    height: 1px;
    background: linear-gradient(to right, var(--color-stibios-accent), var(--color-stibios-purple), transparent);
    opacity: 0.4;
  }

  /* ── Blog Card ── */
  .blog-index__grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* ── Empty state ── */
  .blog-index__empty {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-stibios-dim);
  }

  /* ── Tag filter ── */
  .blog-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .blog-filter__btn {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-stibios-dim);
    background: var(--color-stibios-surface);
    border: 1px solid var(--color-stibios-border);
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .blog-filter__btn:hover {
    border-color: var(--color-stibios-accent);
    color: var(--color-stibios-text);
  }

  .blog-filter__btn.is-active {
    background: var(--color-stibios-accent);
    border-color: var(--color-stibios-accent);
    color: var(--color-stibios-bg);
  }

  /* ── Pagination ── */
  .blog-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }

  .blog-pagination__btn {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-stibios-dim);
    background: var(--color-stibios-surface);
    border: 1px solid var(--color-stibios-border);
    min-width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .blog-pagination__btn:hover:not(:disabled) {
    border-color: var(--color-stibios-accent);
    color: var(--color-stibios-text);
  }

  .blog-pagination__btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .blog-pagination__btn.is-active {
    background: var(--color-stibios-accent);
    border-color: var(--color-stibios-accent);
    color: var(--color-stibios-bg);
  }
</style>

<script>
  const POSTS_PER_PAGE = 6;
  let currentTag = 'all';
  let currentPage = 1;

  const grid = document.getElementById('blog-grid');
  const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.blog-card')) : [];
  const tagButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.blog-filter__btn'));
  const paginationEl = document.getElementById('blog-pagination');
  const emptyFilteredEl = document.getElementById('blog-empty-filtered');

  function getFiltered(): HTMLElement[] {
    return cards.filter(c => currentTag === 'all' || c.dataset.tag === currentTag);
  }

  function renderPagination(totalPages: number) {
    if (!paginationEl) return;
    paginationEl.innerHTML = '';
    if (totalPages <= 1) return;

    const makeBtn = (label: string, page: number, opts: { disabled?: boolean; active?: boolean } = {}) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'blog-pagination__btn' + (opts.active ? ' is-active' : '');
      btn.textContent = label;
      if (opts.disabled) btn.disabled = true;
      btn.addEventListener('click', () => {
        currentPage = page;
        render();
        grid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      return btn;
    };

    paginationEl.appendChild(makeBtn('←', currentPage - 1, { disabled: currentPage === 1 }));
    for (let p = 1; p <= totalPages; p++) {
      paginationEl.appendChild(makeBtn(String(p), p, { active: p === currentPage }));
    }
    paginationEl.appendChild(makeBtn('→', currentPage + 1, { disabled: currentPage === totalPages }));
  }

  function render() {
    const filtered = getFiltered();
    const totalPages = Math.max(1, Math.ceil(filtered.length / POSTS_PER_PAGE));
    currentPage = Math.min(currentPage, totalPages);
    const start = (currentPage - 1) * POSTS_PER_PAGE;
    const end = start + POSTS_PER_PAGE;
    const visible = new Set(filtered.slice(start, end));

    cards.forEach(c => {
      c.style.display = visible.has(c) ? '' : 'none';
    });

    if (emptyFilteredEl) {
      emptyFilteredEl.hidden = filtered.length !== 0;
    }

    renderPagination(totalPages);
  }

  tagButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      currentTag = btn.dataset.tag || 'all';
      currentPage = 1;
      tagButtons.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      render();
    });
  });

  render();
</script>
