---
import Layout from '../../layouts/Layout.astro';

interface PostFrontmatter {
  title: string;
  description?: string;
  date: string;
  tag?: string;
  image?: string;
  draft: boolean;
}

interface Post {
  frontmatter: PostFrontmatter;
  url?: string;
}

const postModules = import.meta.glob('./*.md', { eager: true });
const posts = Object.values(postModules) as Post[];
const sortedPosts = posts
  .filter(p => !p.frontmatter.draft)
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---

<Layout title="Blog" description="Artículos sobre software, negocios digitales y desarrollo a medida por Stibios Labs.">
  <section class="blog-index">
    <div class="blog-index__container">

      <header class="blog-index__header">
        <div class="blog-index__header-label">
          <span class="blog-index__header-dot"></span>
          <span>Blog</span>
        </div>
        <h1 class="blog-index__title">
          Notas & Reflexiones
        </h1>
        <p class="blog-index__subtitle">
          Ideas sobre software, negocios digitales y desarrollo a medida.
        </p>
        <div class="blog-index__header-line"></div>
      </header>

      <div class="blog-index__grid">
        {sortedPosts.map((post, index) => (
          <a
            href={post.url}
            class="blog-card"
            style={`animation-delay: ${index * 100}ms`}
          >
            {post.frontmatter.image && (
              <div class="blog-card__image-wrap">
                <img
                  src={post.frontmatter.image}
                  alt={post.frontmatter.title}
                  class="blog-card__image"
                  loading="lazy"
                />
                <div class="blog-card__image-overlay"></div>
              </div>
            )}
            <div class="blog-card__content">
              <div class="blog-card__meta">
                {post.frontmatter.tag && (
                  <span class="blog-card__tag">
                    {post.frontmatter.tag}
                  </span>
                )}
                <span class="blog-card__date">
                  {(() => {
                    const [y, m, d] = post.frontmatter.date.split('-').map(Number);
                    return new Date(Date.UTC(y, m - 1, d))
                      .toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
                  })()}
                </span>
              </div>
              <h2 class="blog-card__title">
                {post.frontmatter.title}
              </h2>
              {post.frontmatter.description && (
                <p class="blog-card__description">
                  {post.frontmatter.description}
                </p>
              )}
              <span class="blog-card__cta">
                Leer artículo
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
                </svg>
              </span>
            </div>
          </a>
        ))}

        {sortedPosts.length === 0 && (
          <p class="blog-index__empty">Próximamente...</p>
        )}
      </div>

    </div>
  </section>
</Layout>

<style>
  /* ── Blog Index Section ── */
  .blog-index {
    position: relative;
    padding: 7rem 1.5rem 4rem;
  }

  @media (min-width: 768px) {
    .blog-index {
      padding: 9rem 2rem 5rem;
    }
  }

  .blog-index__container {
    max-width: 56rem;
    margin: 0 auto;
  }

  /* ── Header ── */
  .blog-index__header {
    margin-bottom: 3rem;
  }

  .blog-index__header-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-stibios-accent);
    margin-bottom: 0.75rem;
  }

  .blog-index__header-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-stibios-accent);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(0, 209, 255, 0.4); }
    50% { opacity: 0.7; box-shadow: 0 0 0 6px rgba(0, 209, 255, 0); }
  }

  .blog-index__title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-stibios-text);
    line-height: 1.15;
    margin: 0;
  }

  @media (min-width: 768px) {
    .blog-index__title {
      font-size: 2.75rem;
    }
  }

  .blog-index__subtitle {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--color-stibios-dim);
    line-height: 1.5;
  }

  .blog-index__header-line {
    margin-top: 1.5rem;
    height: 1px;
    background: linear-gradient(to right, var(--color-stibios-accent), var(--color-stibios-purple), transparent);
    opacity: 0.4;
  }

  /* ── Blog Card ── */
  .blog-index__grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-stibios-border);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--color-stibios-surface);
    text-decoration: none;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    animation: card-enter 0.5s ease-out both;
  }

  @keyframes card-enter {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .blog-card:hover {
    border-color: var(--color-stibios-accent);
    box-shadow:
      0 0 0 1px rgba(0, 209, 255, 0.1),
      0 8px 32px rgba(0, 0, 0, 0.3),
      0 2px 16px rgba(0, 209, 255, 0.06);
    transform: translateY(-2px);
  }

  @media (min-width: 640px) {
    .blog-card {
      flex-direction: row;
    }
  }

  /* ── Card Image ── */
  .blog-card__image-wrap {
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    height: 10rem;
    background: rgba(0, 0, 0, 0.2);
  }

  @media (min-width: 640px) {
    .blog-card__image-wrap {
      width: 14rem;
      height: auto;
      min-height: 12rem;
    }
  }

  .blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .blog-card:hover .blog-card__image {
    transform: scale(1.06);
  }

  .blog-card__image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0, 209, 255, 0.08), rgba(173, 0, 255, 0.08));
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .blog-card:hover .blog-card__image-overlay {
    opacity: 1;
  }

  /* ── Card Content ── */
  .blog-card__content {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  .blog-card__tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-stibios-accent);
    border: 1px solid rgba(0, 209, 255, 0.25);
    padding: 0.2rem 0.625rem;
    border-radius: 9999px;
    background: rgba(0, 209, 255, 0.06);
  }

  .blog-card__date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-stibios-dim);
  }

  .blog-card__title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-stibios-text);
    line-height: 1.35;
    margin: 0;
    transition: color 0.25s ease;
  }

  .blog-card:hover .blog-card__title {
    color: var(--color-stibios-accent);
  }

  .blog-card__description {
    font-size: 0.85rem;
    color: var(--color-stibios-dim);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-stibios-accent);
    margin-top: 0.25rem;
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.3s ease;
  }

  .blog-card:hover .blog-card__cta {
    opacity: 1;
    transform: translateX(0);
  }

  .blog-card__cta svg {
    transition: transform 0.25s ease;
  }

  .blog-card:hover .blog-card__cta svg {
    transform: translateX(3px);
  }

  /* ── Empty state ── */
  .blog-index__empty {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-stibios-dim);
  }
</style>
