---
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { Shield, Cog, Activity, ServerCrash } from 'lucide-react';
---

<Layout 
  title="Mantenimiento y Soporte Web Profesional" 
  description="Mantenemos tu infraestructura digital segura, rápida y actualizada. Soporte técnico dedicado para que tú solo te preocupes de tu negocio."
>
  <section class="pt-32 pb-20 px-6 max-w-5xl mx-auto relative">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-full h-96 bg-emerald-500/10 blur-[120px] rounded-full pointer-events-none z-0"></div>

    <div class="relative z-10 space-y-8 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 text-emerald-400 text-xs font-mono border border-emerald-500/20 px-3 py-1 rounded-full bg-emerald-500/5">
        <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
        MANTENIMIENTO WEB
      </div>
      
      <h1 class="text-4xl md:text-6xl font-bold tracking-tighter text-white">
        Tu tranquilidad es nuestro <span class="text-emerald-400">objetivo principal.</span>
      </h1>
      
      <p class="text-stibios-dim text-lg leading-relaxed">
        Garantizamos la operatividad continua de tus sistemas con monitorización proactiva, actualizaciones de seguridad y soporte técnico especializado. Nos encargamos de que tu negocio digital nunca se detenga.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#contacto" class="w-full sm:w-auto inline-flex items-center justify-center bg-stibios-text text-stibios-bg font-bold py-3 px-8 rounded hover:bg-white transition-all">
          Solicitar mantenimiento
        </a>
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="py-16 px-6 max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-stibios-surface border border-stibios-border p-8 rounded-2xl flex flex-col gap-4">
        <Shield class="text-emerald-400" size={32} />
        <h3 class="text-xl font-bold text-white">Seguridad Proactiva</h3>
        <p class="text-stibios-dim text-sm leading-relaxed">Protegemos tu web contra vulnerabilidades, malware y ataques con auditorías regulares y actualizaciones constantes del código.</p>
      </div>

      <div class="bg-stibios-surface border border-stibios-border p-8 rounded-2xl flex flex-col gap-4">
        <Activity class="text-emerald-400" size={32} />
        <h3 class="text-xl font-bold text-white">Monitorización 24/7</h3>
        <p class="text-stibios-dim text-sm leading-relaxed">Sistemas de alerta que nos avisan de cualquier caída en tiempo real para intervenir inmediatamente, minimizando el impacto en tus clientes.</p>
      </div>

      <div class="bg-stibios-surface border border-stibios-border p-8 rounded-2xl flex flex-col gap-4">
        <Cog class="text-emerald-400" size={32} />
        <h3 class="text-xl font-bold text-white">Actualizaciones Sin Riesgo</h3>
        <p class="text-stibios-dim text-sm leading-relaxed">Actualizamos frameworks, librerías y servidores en entornos de prueba antes de pasarlo a producción para evitar roturas inesperadas.</p>
      </div>

      <div class="bg-stibios-surface border border-stibios-border p-8 rounded-2xl flex flex-col gap-4">
        <ServerCrash class="text-emerald-400" size={32} />
        <h3 class="text-xl font-bold text-white">Backups Diarios</h3>
        <p class="text-stibios-dim text-sm leading-relaxed">Copias de seguridad automáticas y almacenadas en servidores externos. Si ocurre un desastre, restauramos tu negocio en minutos.</p>
      </div>
    </div>
  </section>

  <Contact />
  <Footer />
</Layout>
