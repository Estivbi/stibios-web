---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import carolinaPhoto from '../assets/carolina.webp';
import {
  Cpu,
  Code2,
  Rocket,
  Package,
  Wind,
  Database,
  Triangle,
  GitBranch
} from 'lucide-react';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Carolina",
  "jobTitle": "Desarrolladora Full Stack & Fundadora de Stibios Labs",
  "url": "https://www.stibios.com/sobre-mi",
  "description": "Especialista en productos digitales para negocios pequeños y creadores. Desarrollo web, automatización y apps a medida.",
  "sameAs": [
    "https://www.linkedin.com/in/carolinarodriguezbarcena/",
    "https://carolinadev.vercel.app"
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.stibios.com" },
    { "@type": "ListItem", "position": 2, "name": "Sobre mí", "item": "https://www.stibios.com/sobre-mi" }
  ]
};

const stack = [
  { name: "React", icon: Cpu },
  { name: "TypeScript", icon: Code2 },
  { name: "Astro", icon: Rocket },
  { name: "Node.js", icon: Package },
  { name: "Tailwind", icon: Wind },
  { name: "PostgreSQL", icon: Database },
  { name: "Vercel", icon: Triangle },
  { name: "Git", icon: GitBranch }
];
---

<Layout
  title="Sobre mí - Carolina"
  description="Soy Carolina, fundadora de Stibios Labs. Especialista en desarrollo web, automatización y productos digitales para pymes y creadores."
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="pt-32 pb-20 px-6 max-w-5xl mx-auto relative">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-full h-96 bg-stibios-accent/5 blur-[120px] rounded-full pointer-events-none z-0"></div>
    <div class="relative z-10 space-y-8 text-center max-w-3xl mx-auto">
      <nav class="text-xs font-mono text-stibios-dim flex items-center justify-center gap-2 reveal" style="--d:0ms" aria-label="Breadcrumb">
        <a href="/" class="hover:text-stibios-accent transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-stibios-text">Sobre mí</span>
      </nav>
      <div class="inline-flex items-center gap-2 text-stibios-accent text-xs font-mono border border-stibios-accent/20 px-3 py-1 rounded-lg bg-stibios-accent/3 reveal" style="--d:80ms">
        <div class="w-2 h-2 rounded-full bg-stibios-accent animate-pulse"></div>
        CAROLINA
      </div>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tighter text-white reveal" style="--d:160ms">
        Desarrolladora Full Stack
      </h1>
      <p class="text-stibios-dim text-lg leading-relaxed max-w-2xl mx-auto reveal" style="--d:240ms">
        Especialista en productos digitales para negocios pequeños y creadores. Construcción de soluciones web, automatización y estrategia digital a medida.
      </p>
    </div>
  </section>

  <!-- Contenido Principal -->
  <section class="py-20 px-6 max-w-5xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start mb-20">
      <!-- Foto -->
      <div class="flex flex-col items-center gap-6">
        <div id="photo-tilt" class="tilt-card rounded-2xl overflow-hidden bg-stibios-surface border border-stibios-border h-96 w-full max-w-sm relative">
          <div class="tilt-card__glow"></div>
          <img
            src={carolinaPhoto.src}
            alt="Carolina, fundadora de Stibios Labs"
            class="w-full h-full object-cover relative z-10"
            loading="eager"
            decoding="async"
          />
        </div>

        <!-- LinkedIn + Portfolio -->
        <div class="flex flex-wrap justify-center gap-3 w-full max-w-sm">
          <a href="https://www.linkedin.com/in/carolinarodriguezbarcena/" target="_blank" rel="noopener noreferrer" class="flex-1 inline-flex items-center justify-center gap-2 bg-stibios-accent/10 text-stibios-accent border border-stibios-accent/20 px-4 py-2.5 rounded-lg hover:bg-stibios-accent/20 transition-colors text-sm font-mono">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            LinkedIn
          </a>
          <a href="https://carolinadev.vercel.app" target="_blank" rel="noopener noreferrer" class="flex-1 inline-flex items-center justify-center gap-2 bg-stibios-surface text-stibios-text border border-stibios-border px-4 py-2.5 rounded-lg hover:border-stibios-accent/50 transition-colors text-sm font-mono">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            Portfolio
          </a>
        </div>

        <!-- CTA principal -->
        <a href="/contacto" class="w-full max-w-sm text-center bg-stibios-text text-stibios-bg font-bold py-3 px-6 rounded-lg hover:bg-white transition-all">
          Trabajemos juntos
        </a>
      </div>

      <!-- Bio -->
      <div class="space-y-6">
        <div>
          <h2 class="text-3xl font-bold text-white mb-4">Quien soy</h2>
          <p class="text-stibios-dim leading-relaxed mb-4">
            Soy <span class="text-white font-bold">Carolina</span>, fundadora de Stibios Labs — un estudio de software unipersonal especializado en productos digitales para negocios pequeños y creadores.
          </p>
          <p class="text-stibios-dim leading-relaxed mb-4">
            Construyo software para mis clientes (la peluquería, el abogado, la revista) y para mí misma (productos propios). Sin intermediarios, sin plantillas — código y estrategia a medida.
          </p>
          <p class="text-stibios-dim leading-relaxed">
            Trabajo de forma <span class="text-stibios-accent font-mono">100% remota</span>, lo que me permite colaborar con negocios de cualquier parte del mundo sin perder la cercanía y la agilidad que me caracteriza.
          </p>
        </div>
      </div>
    </div>

    <!-- Stack -->
    <div>
      <h2 class="text-2xl font-bold text-white mb-8">Stack Tecnológico</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {stack.map((tech, i) => {
          const IconComponent = tech.icon;
          return (
            <div class="stack-card bg-stibios-surface border border-stibios-border rounded-lg p-6 text-center hover:border-stibios-accent/50 hover:-translate-y-1 transition-all duration-300 flex flex-col items-center justify-center gap-3" style={`--i:${i}`}>
              <IconComponent className="w-10 h-10 text-stibios-accent stack-card__icon" />
              <p class="text-stibios-text font-mono text-xs font-bold">{tech.name}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <Footer />

  <style>
    /* ── Hero entrance ── */
    .reveal {
      opacity: 0;
      transform: translateY(16px);
      animation: reveal-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: var(--d, 0ms);
    }
    @keyframes reveal-in {
      to { opacity: 1; transform: translateY(0); }
    }

    /* ── Photo tilt ── */
    .tilt-card {
      transition: transform 0.15s ease-out, border-color 0.3s ease;
      transform-style: preserve-3d;
      will-change: transform;
    }
    .tilt-card:hover {
      border-color: var(--color-stibios-accent);
    }
    .tilt-card__glow {
      position: absolute;
      inset: -20%;
      background: radial-gradient(circle at var(--x, 50%) var(--y, 50%), rgba(8, 145, 178, 0.18), transparent 55%);
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }
    .tilt-card:hover .tilt-card__glow {
      opacity: 1;
    }

    /* ── Stack scroll-reveal ── */
    .stack-card {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.5s ease, transform 0.5s ease, border-color 0.3s ease, box-shadow 0.3s ease;
      transition-delay: calc(var(--i, 0) * 60ms);
    }
    .stack-card.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    .stack-card:hover {
      box-shadow: 0 8px 24px rgba(8, 145, 178, 0.12);
    }
    .stack-card__icon {
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .stack-card:hover .stack-card__icon {
      transform: scale(1.15) rotate(-6deg);
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal, .stack-card {
        animation: none !important;
        transition: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
    }
  </style>

  <script>
    // Photo tilt on mouse move
    const tiltCard = document.getElementById('photo-tilt');
    if (tiltCard) {
      tiltCard.addEventListener('mousemove', (e) => {
        const rect = tiltCard.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const rotateX = ((y / rect.height) - 0.5) * -10;
        const rotateY = ((x / rect.width) - 0.5) * 10;
        tiltCard.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
        tiltCard.style.setProperty('--x', `${(x / rect.width) * 100}%`);
        tiltCard.style.setProperty('--y', `${(y / rect.height) * 100}%`);
      });
      tiltCard.addEventListener('mouseleave', () => {
        tiltCard.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) scale(1)';
      });
    }

    // Stack cards reveal on scroll
    const stackCards = document.querySelectorAll('.stack-card');
    if (stackCards.length) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      stackCards.forEach(card => observer.observe(card));
    }
  </script>
</Layout>
