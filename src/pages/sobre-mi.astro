---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import {
  Cpu,
  Code2,
  Rocket,
  Package,
  Wind,
  Database,
  Triangle,
  GitBranch
} from 'lucide-react';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Carolina Rodríguez Bárcena",
  "jobTitle": "Desarrolladora Full Stack & Fundadora de Stibios Labs",
  "url": "https://www.stibios.com/sobre-mi",
  "description": "Especialista en productos digitales para negocios pequeños y creadores. Desarrollo web, automatización y apps a medida.",
  "sameAs": [
    "https://www.linkedin.com/in/carolinarb94"
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.stibios.com" },
    { "@type": "ListItem", "position": 2, "name": "Sobre mí", "item": "https://www.stibios.com/sobre-mi" }
  ]
};

const stack = [
  { name: "React", icon: Cpu },
  { name: "TypeScript", icon: Code2 },
  { name: "Astro", icon: Rocket },
  { name: "Node.js", icon: Package },
  { name: "Tailwind", icon: Wind },
  { name: "PostgreSQL", icon: Database },
  { name: "Vercel", icon: Triangle },
  { name: "Git", icon: GitBranch }
];
---

<Layout
  title="Sobre mí - Carolina Rodríguez Bárcena"
  description="Soy Carolina, fundadora de Stibios Labs. Especialista en desarrollo web, automatización y productos digitales para pymes y creadores."
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="pt-32 pb-20 px-6 max-w-5xl mx-auto relative">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-full h-96 bg-stibios-accent/5 blur-[120px] rounded-full pointer-events-none z-0"></div>
    <div class="relative z-10 space-y-8 text-center max-w-3xl mx-auto">
      <nav class="text-xs font-mono text-stibios-dim flex items-center justify-center gap-2" aria-label="Breadcrumb">
        <a href="/" class="hover:text-stibios-accent transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-stibios-text">Sobre mí</span>
      </nav>
      <div class="inline-flex items-center gap-2 text-stibios-accent text-xs font-mono border border-stibios-accent/20 px-3 py-1 rounded-lg bg-stibios-accent/3">
        <div class="w-2 h-2 rounded-full bg-stibios-accent animate-pulse"></div>
        CAROLINA RODRÍGUEZ BÁRCENA
      </div>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tighter text-white">
        Desarrolladora Full Stack
      </h1>
      <p class="text-stibios-dim text-lg leading-relaxed max-w-2xl mx-auto">
        Especialista en productos digitales para negocios pequeños y creadores. Construcción de soluciones web, automatización y estrategia digital a medida.
      </p>
    </div>
  </section>

  <!-- Contenido Principal -->
  <section class="py-20 px-6 max-w-5xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start mb-20">
      <!-- Foto placeholder (reemplazar con imagen real) -->
      <div class="flex flex-col items-center gap-6">
        <div class="rounded-2xl overflow-hidden bg-stibios-surface border border-stibios-border h-96 w-full max-w-sm flex items-center justify-center">
          <div class="text-center text-stibios-dim/50">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mx-auto mb-2 opacity-30">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <p class="text-sm">Foto: carolina.webp</p>
          </div>
        </div>
        <!-- LinkedIn link below photo -->
        <a href="https://www.linkedin.com/in/carolinarb94" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-stibios-accent/10 text-stibios-accent border border-stibios-accent/20 px-4 py-2.5 rounded-lg hover:bg-stibios-accent/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          LinkedIn
        </a>
      </div>

      <!-- Bio -->
      <div class="space-y-6">
        <div>
          <h2 class="text-3xl font-bold text-white mb-4">Quien soy</h2>
          <p class="text-stibios-dim leading-relaxed mb-4">
            Soy <span class="text-white font-bold">Carolina Rodríguez Bárcena</span>, fundadora de Stibios Labs — un estudio de software unipersonal especializado en productos digitales para negocios pequeños y creadores.
          </p>
          <p class="text-stibios-dim leading-relaxed mb-4">
            Construyo software para mis clientes (la peluquería, el abogado, la revista) y para mí misma (productos propios). Sin intermediarios, sin plantillas — código y estrategia a medida.
          </p>
          <p class="text-stibios-dim leading-relaxed">
            Trabajo de forma <span class="text-stibios-accent font-mono">100% remota</span>, lo que me permite colaborar con negocios de cualquier parte del mundo sin perder la cercanía y la agilidad que me caracteriza.
          </p>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-stibios-border">
          <div>
            <div class="text-2xl font-bold text-white">+20</div>
            <p class="text-xs font-mono text-stibios-dim">proyectos entregados</p>
          </div>
          <div>
            <div class="text-2xl font-bold text-white">100%</div>
            <p class="text-xs font-mono text-stibios-dim">satisfacción cliente</p>
          </div>
          <div>
            <div class="text-2xl font-bold text-stibios-accent">3+</div>
            <p class="text-xs font-mono text-stibios-dim">años expertise</p>
          </div>
        </div>

        <!-- CTA -->
        <a href="/#contacto" class="inline-block bg-stibios-text text-stibios-bg font-bold py-3 px-6 rounded-lg hover:bg-white transition-all">
          Trabajemos juntos
        </a>
      </div>
    </div>

    <!-- Stack -->
    <div class="mb-20">
      <h2 class="text-2xl font-bold text-white mb-8">Stack Tecnológico</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {stack.map(tech => {
          const IconComponent = tech.icon;
          return (
            <div class="bg-stibios-surface border border-stibios-border rounded-lg p-6 text-center hover:border-stibios-accent/50 transition-colors flex flex-col items-center justify-center gap-3">
              <IconComponent className="w-10 h-10 text-stibios-accent" />
              <p class="text-stibios-text font-mono text-xs font-bold">{tech.name}</p>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Valores -->
    <div>
      <h2 class="text-2xl font-bold text-white mb-8">Valores</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-stibios-surface border border-stibios-border rounded-2xl p-6">
          <div class="text-2xl mb-3">🎯</div>
          <h3 class="text-white font-bold mb-2">Honestidad</h3>
          <p class="text-stibios-dim text-sm">Transparencia total en procesos, presupuestos y capacidades. Sin promesas falsas.</p>
        </div>
        <div class="bg-stibios-surface border border-stibios-border rounded-2xl p-6">
          <div class="text-2xl mb-3">🧠</div>
          <h3 class="text-white font-bold mb-2">Criterio</h3>
          <p class="text-stibios-dim text-sm">No hago lo que pides si creo que no es lo mejor. Mi opinión suma al proyecto.</p>
        </div>
        <div class="bg-stibios-surface border border-stibios-border rounded-2xl p-6">
          <div class="text-2xl mb-3">🤝</div>
          <h3 class="text-white font-bold mb-2">Confianza</h3>
          <p class="text-stibios-dim text-sm">Construyo relaciones a largo plazo. Tu éxito es mi éxito.</p>
        </div>
      </div>
    </div>
  </section>

  <Contact />
  <Footer />
</Layout>
