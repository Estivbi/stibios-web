---
import Layout from '../layouts/Layout.astro';
import TerminalHero from '../components/TerminalHero';
import BentoGrid from '../components/BentoGrid.astro';
import Footer from '../components/Footer.astro';
import StarsBackground from '../components/StarsBackground.astro';
import Philosophy from '../components/Philosophy.astro';
import CustomDevelopment from '../components/CustomDevelopment.astro';
import Contact from '../components/Contact.astro';
import QueHacemos from '../components/QueHacemos.astro';
import Nosotros from '../components/Nosotros.astro';
---

<Layout 
    title="Desarrollo de Software de Alto Rendimiento" 
    description="STIBIOS LABS - Especialistas en desarrollo web profesional, automatización B2B y productos digitales escalables con tecnología de vanguardia."
>
    
    <StarsBackground />

    <section id="inicio" class="min-h-[80vh] flex flex-col justify-center relative" aria-label="Hero">
		<TerminalHero client:load />
	</section>
	<QueHacemos />
	<Philosophy />
    <CustomDevelopment />
    <BentoGrid />
    <Nosotros />
    <Contact />
    <Footer />

</Layout>