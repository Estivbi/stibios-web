---
import Layout from '../layouts/Layout.astro';
import TerminalHero from '../components/TerminalHero';
import Footer from '../components/Footer.astro';
import CustomDevelopment from '../components/CustomDevelopment.astro';
import ExploreMore from '../components/ExploreMore.astro';
import QueHacemos from '../components/QueHacemos.astro';
---

<Layout
    title="Desarrollo Web y Automatización con IA para Negocios"
    description="Creo webs y automatizo tareas con IA para peluquerías, clínicas y negocios pequeños en España. Sin agencias ni plantillas — hablas directamente conmigo."
>

    <section
		id="inicio"
		class="hero-section min-h-[80vh] flex flex-col justify-center relative overflow-hidden"
		aria-label="Hero"
	>
		<div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-full max-w-3xl h-96 bg-stibios-accent/10 blur-3xl rounded-full pointer-events-none z-0"></div>
		<div class="absolute -top-20 right-0 w-80 h-80 bg-stibios-purple/10 blur-3xl rounded-full pointer-events-none z-0"></div>

		{/* Static SSR content — visible immediately to crawlers */}
		<div class="relative z-10 w-full max-w-5xl mx-auto px-4 text-center flex flex-col items-center pt-48">
			{/* Positioning pill */}
			<div class="inline-flex items-center gap-2 text-stibios-accent text-xs font-mono mb-8 border border-stibios-accent/20 px-4 py-1.5 rounded-full bg-stibios-accent/5">
				<div class="w-1.5 h-1.5 rounded-full bg-stibios-accent animate-pulse"></div>
				Software para negocios reales · Creadores · PYMES
			</div>

			<h1 class="text-5xl md:text-8xl font-bold mb-6 tracking-tighter leading-[1.1] md:leading-[1.1]">
				<span class="block text-stibios-text">Tu negocio merece</span>
				<span class="block text-transparent bg-clip-text bg-gradient-to-r from-stibios-accent via-stibios-purple to-stibios-accent bg-[length:200%_auto] animate-shimmer pb-2">
					software de verdad
				</span>
			</h1>

			<p class="text-stibios-dim text-lg md:text-xl max-w-2xl mb-10 leading-relaxed text-center mx-auto">
				Construyo productos digitales para peluquerías, creadores, clínicas y negocios con ambición.
				Sin agencias intermediarias. Sin plantillas. Código y estrategia a medida.
			</p>

			{/* Quick stats */}
			<div class="flex flex-wrap justify-center gap-8 mb-12 font-mono text-xs text-stibios-dim">
				<div class="flex flex-col items-center gap-1">
					<span class="text-stibios-text text-2xl font-bold">+20</span>
					<span>proyectos entregados</span>
				</div>
				<div class="w-px h-10 bg-stibios-border self-center hidden sm:block"></div>
				<div class="flex flex-col items-center gap-1">
					<span class="text-stibios-accent text-2xl font-bold">3</span>
					<span>productos propios</span>
				</div>
			</div>

			{/* Interactive buttons island — hydrated only when browser is idle */}
			<TerminalHero client:idle />
		</div>
	</section>

	<QueHacemos />
    <CustomDevelopment />
    <ExploreMore />
    <Footer />

</Layout>