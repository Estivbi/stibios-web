---
import '@fontsource/jetbrains-mono';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import InfoModal from '../components/InfoModal.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { 
	title, 
	description = "Stibios Labs — Estudio de software especializado en productos digitales para negocios pequeños y creadores. Desarrollo web, apps y automatización a medida.",
	image = "/og-image.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://stibios.com");

const schema = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	"name": "Stibios Labs",
	"description": "Estudio de software unipersonal especializado en productos digitales para negocios pequeños y creadores.",
	"url": "https://stibios.com",
	"logo": "https://stibios.com/logo.png",
	"founder": {
		"@type": "Person",
		"name": "Stibios Labs"
	},
	"areaServed": "ES",
	"serviceType": ["Desarrollo web", "Automatización", "Apps móviles", "Productos digitales"],
	"sameAs": [
		"https://linkedin.com/company/stibios-labs"
	]
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/logo.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/logo.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="robots" content="index, follow" />
		<meta name="googlebot" content="index, follow" />
		<meta name="keywords" content="desarrollo web negocios pequeños, software peluquerías, app reservas, productos digitales creadores, desarrollo web España, automatización pymes, estudio software" />
		<meta name="author" content="Stibios Labs" />

		<!-- SEO -->
		<title>{title} | Stibios Labs</title>
		<meta name="title" content={`${title} | Stibios Labs`} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={`${title} | Stibios Labs`} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Stibios Labs" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={`${title} | Stibios Labs`} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />

		<meta name="theme-color" content="#1d1f27" />

		<!-- Schema.org -->
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />

		<!-- Google Analytics con Consent Mode -->
		<script is:inline>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		const savedConsent = typeof localStorage !== 'undefined' ? localStorage.getItem('cookie-consent') : null;
		gtag('consent', 'default', {
			'analytics_storage': savedConsent === 'granted' ? 'granted' : 'denied',
			'ad_storage': savedConsent === 'granted' ? 'granted' : 'denied',
			'wait_for_update': 500
		});
		</script>
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-Q05VJ2JTT2"></script>
		<script is:inline>
		gtag('js', new Date());
		gtag('config', 'G-Q05VJ2JTT2');
		</script>
	</head>
	<body class="bg-stibios-bg text-stibios-text font-sans antialiased selection:bg-stibios-accent selection:text-stibios-bg">
		<div class="fixed inset-0 z-[-1] opacity-5 pointer-events-none mix-blend-overlay" 
             style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');">
        </div>
		<Navbar />
		<main class="min-h-screen flex flex-col relative overflow-hidden">
			<slot />
		</main>
		<InfoModal />
		<CookieBanner />
		<Analytics />
	</body>
</html>
