---
import '@fontsource/jetbrains-mono';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import InfoModal from '../components/InfoModal.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { 
	title, 
	description = "STIBIOS LABS - Estudio de software especializado en soluciones B2B, automatización y desarrollo web de alto rendimiento con Astro.",
	image = "/logo.png" // Asumiendo que el usuario lo pondrá en public o usaremos una ref
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://stibios.net");
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/logo.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Primario -->
		<title>{title} | STIBIOS LABS</title>
		<meta name="title" content={`${title} | STIBIOS LABS`} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />

		<meta name="theme-color" content="#050505" />
	</head>
	<body class="bg-stibios-bg text-stibios-text font-sans antialiased selection:bg-stibios-accent selection:text-stibios-bg">
		<div class="fixed inset-0 z-[-1] opacity-5 pointer-events-none mix-blend-overlay" 
             style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');">
        </div>
		<Navbar />
		<main class="min-h-screen flex flex-col relative overflow-hidden">
			<slot />
		</main>
		<InfoModal />
	</body>
</html>