# Push notifications VAPID (ya generadas, puedes usar las de abajo o generar nuevas)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BM7VcgB3ezNtFkjfdfOgOoLeXQHsr3_4rJS1SymCHlGTUW0m-dLXBmJLyBjL6MAwa7TEl0sSnpyFcSEvSPLKbuM
VAPID_PRIVATE_KEY=aXjhE_om4XhGb0mCZf3lTBsVtikyvxjkcBOrSJ4M3Ws

# Secreto para proteger /api/push/notify (ponle algo aleatorio largo)
